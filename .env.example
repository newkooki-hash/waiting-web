# 복사해서 .env로 저장하고 값을 채우세요 (.env는 커밋되지 않음)
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=dev
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SMS 발송 (솔라피). 비워 두면 인증번호가 서버 콘솔에만 출력됩니다(개발용)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 인증번호 해시용 비밀값 (임의의 긴 문자열)
CODE_SECRET=
